/*
===============================================================================
Load Bronze Layer (MySQL client batch script)
===============================================================================
LOAD DATA is intentionally outside a stored procedure because MySQL does not
allow LOAD DATA [LOCAL] INFILE inside stored programs.

This script matches the tables in the current bronze database:
bronze_crm_* and bronze_erp_*.
===============================================================================
*/

-- CRM Customer

SET @start_time = NOW(6);

LOAD DATA LOCAL INFILE
'D:/MYSQL/sql-data-warehouse-project/datasets/source_crm/cust_info.csv'
INTO TABLE bronze_crm_cust_info
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS;

SET @end_time = NOW(6);

SELECT
    'bronze_crm_cust_info' AS table_name,
    TIMESTAMPDIFF(MICROSECOND, @start_time, @end_time) / 1000000
        AS load_time_seconds;


